{
  "rules": {
    "rooms": {
      "$room": {
        ".validate": "$room.matches(/^[a-z0-9_-]{1,40}$/)",
        ".read": "auth != null",
        "players": {
          "$seat": {
            ".write": "auth != null && (!data.exists() || data.child('u').val() === auth.uid)",
            ".validate": "$seat.matches(/^[ab]$/) && newData.child('u').val() === auth.uid && (!newData.hasChild('name') || (newData.child('name').isString() && newData.child('name').val().length <= 20))"
          }
        }
      }
    },
    "queue": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (auth.uid === $id || !newData.exists())",
        ".validate": "newData.child('room').isString() && newData.child('room').val().matches(/^q-[a-z0-9]{6}$/)"
      }
    }
  }
}
